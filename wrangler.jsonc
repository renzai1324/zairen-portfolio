{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zairen-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "zairen-portfolio-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "zairen-portfolio-media" }]
}
